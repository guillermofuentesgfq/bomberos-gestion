# ---------------------------------------------------------------------------
# Plantilla de variables de entorno.
#
# IMPORTANTE
#   `wrangler dev` NO lee este archivo ni un `.env`.
#   Para desarrollo local, copia esta plantilla a `.dev.vars`, que es el
#   archivo que Wrangler sí lee:
#
#       cp .env.example .dev.vars
#
#   En producción los secretos se definen con:
#       npx wrangler secret put <NOMBRE>
#   y nunca se escriben en el repositorio ni en `wrangler.jsonc`.
#
#   `.dev.vars` está en `.gitignore`: no se sube.
# ---------------------------------------------------------------------------

# --- Entorno ---------------------------------------------------------------
# "development" desactiva la marca Secure de la cookie de sesión para poder
# trabajar sobre http. En producción debe ser "production".
APP_ENV=development

# --- Secretos obligatorios -------------------------------------------------
# Genera cada valor con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No pueden quedar vacíos: el hash de contraseñas exige un pepper de al menos
# 16 caracteres.

# Pepper que se mezcla en el hash de contraseñas (PBKDF2 + HMAC).
AUTH_PASSWORD_PEPPER=

# Secreto con el que se derivan los hashes de sesión y de IP.
AUTH_SESSION_SECRET=

# Token de un solo uso para crear el primer administrador desde /setup.
# Elige un valor propio y, tras crear el administrador, cámbialo o elimínalo.
BOOTSTRAP_TOKEN=
