# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
# NEVER commit real secrets. This file contains no credentials.
# ---------------------------------------------------------------------------

# --- Secrets (set with `wrangler secret put <NAME>`, not in wrangler.jsonc) ---
# Pepper mixed into password hashing (PBKDF2). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PASSWORD_PEPPER=

# Secret used to sign/derive session tokens. Generate the same way as above.
AUTH_SESSION_SECRET=

# One-time secret required to bootstrap the first administrator account.
# Remove the corresponding Worker secret after the first admin is created.
BOOTSTRAP_TOKEN=

# --- Local development only (used by `wrangler dev`, ignored in production) ---
# Base URL of the local API, used by the Vite dev server proxy.
VITE_API_BASE=http://127.0.0.1:8787

# --- Institutional defaults (non-secret; can also be set from the admin panel) ---
INSTITUTION_NAME=
INSTITUTION_SHORT_NAME=
