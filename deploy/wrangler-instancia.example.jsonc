// ---------------------------------------------------------------------------
// Configuración de despliegue de UNA institución · EJEMPLO
//
// Cópialo a la RAÍZ de tu repositorio con un nombre propio, por ejemplo
// `wrangler.mi-compania.jsonc`, y rellena los tres valores marcados con
// MAYÚSCULAS. El `deploy/README.md` explica el procedimiento completo.
//
// ¿Por qué en la raíz y no aquí dentro?
//   Wrangler resuelve `main`, `assets.directory` y `migrations_dir` **relativos
//   al archivo de configuración**. Desde `deploy/` buscaría
//   `deploy/src/worker/index.ts` y fallaría con «entry-point file was not
//   found». Desde la raíz, las rutas de abajo son las correctas.
//
// ¿Por qué un archivo propio y no editar `wrangler.jsonc`?
//   `wrangler.jsonc` pertenece al proyecto: el upstream lo cambia cuando añade
//   rutas o ajustes. Si tu copia lo editara, cada actualización chocaría. Este
//   archivo, en cambio, no existe en el upstream y nunca se toca al actualizar.
//
// Nunca escribas secretos aquí: solo identificadores. Los secretos se definen
// con `wrangler secret put` (en producción) y en `.dev.vars` (en local).
// ---------------------------------------------------------------------------
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Nombre del Worker en tu cuenta. Minúsculas y guiones, y único en la cuenta.
  //
  // Con `workers_dev` activo (que es lo que hace esta plantilla sin tocar nada)
  // este nombre **es la etiqueta de DNS** de la dirección
  // `<name>.<tu-subdominio>.workers.dev`. Restricciones: 63 caracteres o menos,
  // solo `a-z`, `A-Z`, `0-9` y guiones, y sin empezar ni terminar en guion.
  // Renombrar el Worker cambia la URL y obliga a entrar de nuevo a todo el
  // mundo (la cookie de sesión es del anfitrión): elige un nombre estable.
  "name": "mi-institucion",

  // El punto de entrada no cambia: es el mismo Worker para toda institución.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // --- Dirección del sitio ---------------------------------------------------
  //
  // ESTA PLANTILLA DESPLEGA EN `workers.dev`, SIN DOMINIO PROPIO. No hay que
  // hacer nada más: `workers_dev` está activo por defecto y `routes` está
  // comentado. El sitio queda en
  // `https://<name>.<tu-subdominio>.workers.dev`, que es la dirección gratuita
  // que genera Cloudflare para tu cuenta.
  //
  // Para qué es: **acceso a coste cero**, mientras no hay presupuesto para un
  // dominio o mientras este no existe. Para la instalación real de una
  // institución la recomendación es un dominio propio: la dirección es parte de
  // la identidad de la institución, y Cloudflare no ofrece `workers.dev` como
  // servicio de negocio (lo documenta como *Free website* y recomienda ruta o
  // dominio para producción).
  //
  // No es una decisión irreversible: pasar de aquí a un dominio no mueve tus
  // datos, solo cambia por dónde se entra.
  //
  // El subdominio es un ajuste **de la cuenta**, no del Worker, y conviene
  // fijarlo antes del primer despliegue: panel → Workers & Pages → Change
  // junto a *Your subdomain*.
  //
  // Procedimiento completo y qué conviene saber antes de decidirse:
  // `docs/DEPLOYMENT.md` §11, «Elegir la dirección del sitio».
  //
  // --- Dominio propio (recomendado para la instalación real) ------------------
  //
  // Con `custom_domain: true`, el propio despliegue crea el registro DNS y el
  // certificado: no hay que tocar el panel. Requisito: el dominio tiene que
  // estar dado de alta como zona **en esta misma cuenta de Cloudflare**; si no,
  // el despliegue falla con «Couldn't find a zone named … in this account» y no
  // publica nada.
  //
  // Está comentado a propósito: así esta plantilla despliega tal cual (en la
  // dirección `workers.dev`) antes de que el dominio esté listo. Descoméntalo y
  // pon tu dominio cuando lo tengas.
  //
  // ⚠ AL DESCOMENTAR `routes`, LA DIRECCIÓN `workers.dev` SE APAGA. Wrangler
  // decide `workers_dev` así: si no lo declaras, vale `routes.length === 0`.
  // Con una entrada en `routes` el valor por defecto pasa a `false` y
  // `…workers.dev` deja de responder en ese mismo despliegue.
  //
  //   · Para que las dos direcciones respondan mientras el dominio propaga,
  //     declara `"workers_dev": true` JUNTO a `routes`.
  //   · Cuando el dominio funcione, ciérrala con `"workers_dev": false`: dos
  //     direcciones para el mismo sitio es contenido duplicado para los
  //     buscadores.
  //
  // Si quieres que también responda `www.tu-dominio.cl`, añade una segunda
  // entrada. Ten en cuenta que entonces el sitio vive en dos direcciones, con
  // sesiones separadas (la cookie es del anfitrión) y contenido duplicado para
  // los buscadores: lo recomendable es elegir una canónica y redirigir la otra
  // con una Regla de redirección de la zona. Un `_redirects` no sirve: en
  // Workers no admite reglas por dominio.
  //
  // "routes": [
  //   { "pattern": "tu-dominio.cl", "custom_domain": true },
  //   { "pattern": "www.tu-dominio.cl", "custom_domain": true }
  // ],
  //
  // "workers_dev": false,

  "assets": {
    "directory": "./dist/web",
    // `binding` es obligatorio: sin él, `env.ASSETS` no existe y la portada
    // responde 500 («Cannot read properties of undefined»).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/sitemap.xml",
      "/robots.txt",
      "/favicon.ico",
      "/apple-touch-icon.png"
    ]
  },

  // Limpieza diaria de sesiones, intentos de ingreso y reservas caducadas.
  "triggers": {
    "crons": ["0 4 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi-base-d1",
      // Lo devuelve `wrangler d1 create`. Sustituye el marcador por tu UUID.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mi-bucket-r2"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    // En producción siempre "production": activa la marca Secure de la cookie.
    "APP_ENV": "production"
  }
}
