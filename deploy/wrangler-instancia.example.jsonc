// ---------------------------------------------------------------------------
// Configuración de despliegue de UNA institución · EJEMPLO
//
// Cópialo a la RAÍZ de tu repositorio con un nombre propio, por ejemplo
// `wrangler.mi-compania.jsonc`, y rellena los tres valores marcados con
// MAYÚSCULAS. El `deploy/README.md` explica el procedimiento completo.
//
// ¿Por qué en la raíz y no aquí dentro?
//   Wrangler resuelve `main`, `assets.directory` y `migrations_dir` **relativos
//   al archivo de configuración**. Desde `deploy/` buscaría
//   `deploy/src/worker/index.ts` y fallaría con «entry-point file was not
//   found». Desde la raíz, las rutas de abajo son las correctas.
//
// ¿Por qué un archivo propio y no editar `wrangler.jsonc`?
//   `wrangler.jsonc` pertenece al proyecto: el upstream lo cambia cuando añade
//   rutas o ajustes. Si tu copia lo editara, cada actualización chocaría. Este
//   archivo, en cambio, no existe en el upstream y nunca se toca al actualizar.
//
// Nunca escribas secretos aquí: solo identificadores. Los secretos se definen
// con `wrangler secret put` (en producción) y en `.dev.vars` (en local).
// ---------------------------------------------------------------------------
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Nombre del Worker en tu cuenta. Minúsculas y guiones, y único en la cuenta.
  "name": "mi-institucion",

  // El punto de entrada no cambia: es el mismo Worker para toda institución.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // --- Dominio de la institución (opcional, pero recomendado) ---------------
  //
  // Con `custom_domain: true`, el propio despliegue crea el registro DNS y el
  // certificado: no hay que tocar el panel. Requisito: el dominio tiene que
  // estar dado de alta como zona **en esta misma cuenta de Cloudflare**; si no,
  // el despliegue falla con «Couldn't find a zone named … in this account» y no
  // publica nada.
  //
  // Está comentado a propósito: así esta plantilla despliega tal cual (en la
  // dirección `workers.dev`) antes de que el dominio esté listo. Descoméntalo y
  // pon tu dominio cuando lo tengas.
  //
  // Si quieres que también responda `www.tu-dominio.cl`, añade una segunda
  // entrada. Ten en cuenta que entonces el sitio vive en dos direcciones, con
  // sesiones separadas (la cookie es del anfitrión) y contenido duplicado para
  // los buscadores: lo recomendable es elegir una canónica y redirigir la otra
  // con una Regla de redirección de la zona. Un `_redirects` no sirve: en
  // Workers no admite reglas por dominio.
  //
  // "routes": [
  //   { "pattern": "tu-dominio.cl", "custom_domain": true },
  //   { "pattern": "www.tu-dominio.cl", "custom_domain": true }
  // ],
  //
  // Cuando el dominio funcione, puedes cerrar el acceso por la dirección
  // `<worker>.<subdominio>.workers.dev` (dos direcciones para el mismo sitio es
  // contenido duplicado para los buscadores). No lo hagas antes: mientras el
  // dominio propaga, `workers.dev` es tu red de seguridad.
  //
  // "workers_dev": false,

  "assets": {
    "directory": "./dist/web",
    // `binding` es obligatorio: sin él, `env.ASSETS` no existe y la portada
    // responde 500 («Cannot read properties of undefined»).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/sitemap.xml",
      "/robots.txt",
      "/favicon.ico",
      "/apple-touch-icon.png"
    ]
  },

  // Limpieza diaria de sesiones, intentos de ingreso y reservas caducadas.
  "triggers": {
    "crons": ["0 4 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi-base-d1",
      // Lo devuelve `wrangler d1 create`. Sustituye el marcador por tu UUID.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mi-bucket-r2"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    // En producción siempre "production": activa la marca Secure de la cookie.
    "APP_ENV": "production"
  }
}
