{
  "name": "bomberos-gestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestión de inventario, personal y sitio web institucional para compañías y cuerpos de bomberos de Chile. Open source, autodesplegable y de una instalación por institución.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local",
    "start": "npm run build && wrangler dev --local",
    "local:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply DB --local",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  }
}
